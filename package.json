{
	"name": "@drupflare/drangler",
	"version": "0.1.0",
	"type": "module",
	"description": "CLI for starting, maintaining and migrating a drupflare site",
	"license": "MIT",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"bin": {
		"drangler": "./src/cli.ts"
	},
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"sideEffects": false,
	"files": [
		"src",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"drangler": "bun src/cli.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/e2e/fixture-worker/tsconfig.json --noEmit",
		"test": "vitest run --project=unit",
		"test:watch": "vitest --project=unit",
		"test:coverage": "vitest run --project=unit --coverage",
		"test:e2e": "vitest run --project=e2e",
		"test:e2e:coverage": "vitest run --project=e2e --coverage",
		"test:e2e:clone": "vitest run --project=e2e tests/e2e/workspace-clone.spec.ts",
		"e2e:up": "bun tests/e2e/stack.ts up",
		"e2e:down": "bun tests/e2e/stack.ts down",
		"build:binary": "bun build --compile --minify --outfile dist/drangler src/cli.ts",
		"prettier": "prettier --write .",
		"prettier:check": "prettier --check .",
		"prepare": "husky",
		"docs:build": "typedoc",
		"docs:serve": "typedoc --watch"
	},
	"dependencies": {
		"commander": "^15.0.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260815.1",
		"@types/node": "^26.0.0",
		"@vitest/coverage-v8": "^5.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-sh": "^0.19.0",
		"typedoc": "^0.28.20",
		"typescript": "^5.9.3",
		"vitest": "^5.0.0",
		"wrangler": "^4.123.0"
	},
	"author": "Gregory Mitchell <me@gmitch215.xyz>",
	"homepage": "https://github.com/drupflare/drangler",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/drupflare/drangler.git"
	},
	"bugs": {
		"url": "https://github.com/drupflare/drangler/issues"
	},
	"keywords": [
		"drupal",
		"drupflare",
		"cloudflare",
		"workers",
		"cli",
		"migration",
		"vps"
	],
	"lint-staged": {
		"*.{ts,js,mjs,css,md,json,jsonc}": "prettier --write"
	}
}
